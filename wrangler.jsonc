{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "product-portfolio-preview",
  "main": "worker.js",
  "compatibility_date": "2026-07-21",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
